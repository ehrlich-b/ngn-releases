+func (context *SearchContext) recordDemandPush(depth int, kind uint8, updateCount int, refresh Color) {
+	frame := demandFrame{kind: kind, updateCount: uint8(updateCount), refresh: refresh}
+	context.demandFrames[depth] = frame
+	if uint64(depth) > context.demandDiagnostics.MaxDepth {
+		context.demandDiagnostics.MaxDepth = uint64(depth)
+	}
+	if kind == demandFrameNull {
+		context.demandDiagnostics.NullPushes++
+		context.demandDiagnostics.NullCopyPerspectivesTotal += 2
+		return
+	}
+	context.demandDiagnostics.MovePushes++
+	context.demandDiagnostics.MoveCopyPerspectivesTotal += 2
+	updatePerspectives := uint64(2)
+	if refresh == White || refresh == Black {
+		updatePerspectives--
+		context.demandDiagnostics.RefreshPerspectivesTotal++
+	}
+	switch updateCount {
+	case 2:
+		context.demandDiagnostics.Update2PerspectivesTotal += updatePerspectives
+	case 3:
+		context.demandDiagnostics.Update3PerspectivesTotal += updatePerspectives
+	case 4:
+		context.demandDiagnostics.Update4PerspectivesTotal += updatePerspectives
+	}
+}
+
+func demandPerspectiveCount(mask uint8) uint64 {
+	return uint64(bits.OnesCount8(mask & demandBothPerspectives))
+}
+
+func (context *SearchContext) classifyDemandPop() {
+	frame := context.demandFrames[context.depth]
+	parent := &context.demandFrames[context.depth-1]
+	needed := frame.needMask & demandBothPerspectives
+	if frame.kind == demandFrameNull {
+		if needed == 0 {
+			context.demandDiagnostics.NullFramesAbandoned++
+		} else {
+			context.demandDiagnostics.NullFramesRequired++
+			if frame.direct {
+				context.demandDiagnostics.NullFramesDirect++
+			} else {
+				context.demandDiagnostics.NullFramesDescendantOnly++
+			}
+		}
+		required := demandPerspectiveCount(needed)
+		context.demandDiagnostics.NullCopyPerspectivesRequired += required
+		context.demandDiagnostics.NullCopyPerspectivesAbandoned += 2 - required
+		parent.needMask |= needed
+		return
+	}
+
+	if needed == 0 {
+		context.demandDiagnostics.MoveFramesAbandoned++
+	} else {
+		context.demandDiagnostics.MoveFramesRequired++
+		if frame.direct {
+			context.demandDiagnostics.MoveFramesDirect++
+		} else {
+			context.demandDiagnostics.MoveFramesDescendantOnly++
+		}
+	}
+	copyNeeded := needed
+	if frame.refresh == White || frame.refresh == Black {
+		refreshBit := uint8(1) << uint8(frame.refresh)
+		copyNeeded &^= refreshBit
+		if needed&refreshBit != 0 {
+			context.demandDiagnostics.RefreshPerspectivesRequired++
+		} else {
+			context.demandDiagnostics.RefreshPerspectivesAbandoned++
+		}
+	}
+	copyRequired := demandPerspectiveCount(copyNeeded)
+	context.demandDiagnostics.MoveCopyPerspectivesRequired += copyRequired
+	context.demandDiagnostics.MoveCopyPerspectivesAbandoned += 2 - copyRequired
+
+	updateRequired := copyRequired
+	updateTotal := uint64(2)
+	if frame.refresh == White || frame.refresh == Black {
+		updateTotal--
+	}
+	updateAbandoned := updateTotal - updateRequired
+	switch frame.updateCount {
+	case 2:
+		context.demandDiagnostics.Update2PerspectivesRequired += updateRequired
+		context.demandDiagnostics.Update2PerspectivesAbandoned += updateAbandoned
+	case 3:
+		context.demandDiagnostics.Update3PerspectivesRequired += updateRequired
+		context.demandDiagnostics.Update3PerspectivesAbandoned += updateAbandoned
+	case 4:
+		context.demandDiagnostics.Update4PerspectivesRequired += updateRequired
+		context.demandDiagnostics.Update4PerspectivesAbandoned += updateAbandoned
+	}
+	parent.needMask |= copyNeeded
+}
