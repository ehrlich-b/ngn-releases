+// EnableDemandDiagnostics starts the disposable L0 observer. It may only be
+// enabled on a balanced context so every subsequent pushed frame is classified.
+func (context *SearchContext) EnableDemandDiagnostics() error {
+	if err := context.validate(); err != nil {
+		return err
+	}
+	if context.depth != 0 {
+		return fmt.Errorf("rodent v1.2 demand diagnostics: enable at depth %d, want 0", context.depth)
+	}
+	context.demandEnabled = true
+	context.demandFrames = make([]demandFrame, len(context.accumulators))
+	context.demandFrames[0] = demandFrame{kind: demandFrameRoot, refresh: Color(2)}
+	context.demandDiagnostics = DemandDiagnostics{}
+	return nil
+}
+
+// DiagnosticDemandCounts returns the current disposable L0 counters.
+func (context *SearchContext) DiagnosticDemandCounts() DemandDiagnostics {
+	if context == nil || !context.demandEnabled {
+		return DemandDiagnostics{}
+	}
+	return context.demandDiagnostics
+}
+
+// ResetDiagnosticDemandCounts clears counters between frozen fixtures without
+// disabling the observer or reallocating its frame metadata.
+func (context *SearchContext) ResetDiagnosticDemandCounts() error {
+	if err := context.validate(); err != nil {
+		return err
+	}
+	if !context.demandEnabled {
+		return fmt.Errorf("rodent v1.2 demand diagnostics: observer is disabled")
+	}
+	if context.depth != 0 {
+		return fmt.Errorf("rodent v1.2 demand diagnostics: reset at depth %d, want 0", context.depth)
+	}
+	context.demandDiagnostics = DemandDiagnostics{}
+	context.demandFrames[0] = demandFrame{kind: demandFrameRoot, refresh: Color(2)}
+	return nil
+}
