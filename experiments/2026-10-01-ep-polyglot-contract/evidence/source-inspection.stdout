    24	var polyglotPieces = [12]Piece{
    25		BlackPawn, WhitePawn,
    26		BlackKnight, WhiteKnight,
    27		BlackBishop, WhiteBishop,
    28		BlackRook, WhiteRook,
    29		BlackQueen, WhiteQueen,
    30		BlackKing, WhiteKing,
    31	}
    32
    33	// Polyglot random numbers for Zobrist hashing
    34	// These are the standard Polyglot random numbers
    35	var polyglotRandom [781]uint64
    36
    37	func init() {
    38		// Initialize Polyglot random numbers
    39		// Using the standard Polyglot PRNG seed
    40		initPolyglotRandom()
    41	}
    42
    43	// PRNG for Polyglot (same algorithm used in original Polyglot)
    44	func polyglotPRNG(seed *uint64) uint64 {
    45		*seed ^= *seed >> 12
    46		*seed ^= *seed << 25
    47		*seed ^= *seed >> 27
    48		return *seed * 2685821657736338717
    49	}
    50
    51	func initPolyglotRandom() {
    52		seed := uint64(1)
    53		for i := 0; i < 781; i++ {
    54			polyglotRandom[i] = polyglotPRNG(&seed)
    55		}
    56	}
    57
    58	// PolyglotHash computes the Polyglot hash for a position
    59	func PolyglotHash(pos *Position) uint64 {
    60		var hash uint64
    61
    62		// Pieces on squares
    63		for sq := 0; sq < 64; sq++ {
    64			piece := pos.Board.PieceAt(Square(sq))
    65			if piece != NoPiece {
    66				// Convert to Polyglot piece index
    67				polyPiece := -1
    68				switch piece {
    69				case BlackPawn:
    70					polyPiece = 0
    68
    69		t.Log("Correctly returned no book move for middlegame position")
    70	}
    71
