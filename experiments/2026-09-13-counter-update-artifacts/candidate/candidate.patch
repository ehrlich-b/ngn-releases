+// Preserve the established portable copy followed by ordered complete-row
+// updates. Only amd64.v3 replaces this sequence with fused lane-independent
+// arithmetic.
+func copyAndApplyFeatureUpdates(
+	child, parent *[HiddenSize]float32,
+	model *Model,
+	updates *[4]featureUpdate,
+	updateCount int,
+) {
