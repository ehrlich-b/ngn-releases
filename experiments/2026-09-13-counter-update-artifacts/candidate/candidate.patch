 	RET
+
+// Copy a parent frame and apply the ordinary move sequence: subtract, add.
+TEXT ·copyAndUpdate2AVX2(SB), NOSPLIT, $0-32
+	MOVQ child+0(FP), AX
+	MOVQ parent+8(FP), BX
+	MOVQ remove+16(FP), CX
+	MOVQ add+24(FP), DX
+	MOVL $64, SI
+copy_update2_loop:
+	VMOVUPS (BX), Y0
+	VSUBPS (CX), Y0, Y0
+	VADDPS (DX), Y0, Y0
+	VMOVUPS Y0, (AX)
+	ADDQ $32, AX
+	ADDQ $32, BX
+	ADDQ $32, CX
+	ADDQ $32, DX
+	DECL SI
+	JNZ copy_update2_loop
+	VZEROUPPER
+	RET
+
+// Copy a parent frame and apply a capture sequence: subtract, subtract, add.
+TEXT ·copyAndUpdate3AVX2(SB), NOSPLIT, $0-40
+	MOVQ child+0(FP), AX
+	MOVQ parent+8(FP), BX
+	MOVQ remove0+16(FP), CX
+	MOVQ remove1+24(FP), DX
+	MOVQ add+32(FP), SI
+	MOVL $64, DI
+copy_update3_loop:
+	VMOVUPS (BX), Y0
+	VSUBPS (CX), Y0, Y0
+	VSUBPS (DX), Y0, Y0
+	VADDPS (SI), Y0, Y0
+	VMOVUPS Y0, (AX)
+	ADDQ $32, AX
+	ADDQ $32, BX
+	ADDQ $32, CX
+	ADDQ $32, DX
+	ADDQ $32, SI
+	DECL DI
+	JNZ copy_update3_loop
+	VZEROUPPER
+	RET
+
+// Copy a parent frame and apply castling: subtract, add, subtract, add.
+TEXT ·copyAndUpdate4AVX2(SB), NOSPLIT, $0-48
+	MOVQ child+0(FP), AX
+	MOVQ parent+8(FP), BX
+	MOVQ remove0+16(FP), CX
+	MOVQ add0+24(FP), DX
+	MOVQ remove1+32(FP), SI
+	MOVQ add1+40(FP), DI
+	MOVL $64, R8
+copy_update4_loop:
+	VMOVUPS (BX), Y0
+	VSUBPS (CX), Y0, Y0
+	VADDPS (DX), Y0, Y0
+	VSUBPS (SI), Y0, Y0
+	VADDPS (DI), Y0, Y0
+	VMOVUPS Y0, (AX)
+	ADDQ $32, AX
+	ADDQ $32, BX
+	ADDQ $32, CX
+	ADDQ $32, DX
+	ADDQ $32, SI
+	ADDQ $32, DI
+	DECL R8
+	JNZ copy_update4_loop
+	VZEROUPPER
+	RET
