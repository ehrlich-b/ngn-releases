+func TestCopyAndApplyFeatureUpdatesMatchesOrderedPortableBits(t *testing.T) {
+	cases := []struct {
+		name    string
+		updates [4]featureUpdate
+		count   int
+	}{
+		{"ordinary", [4]featureUpdate{{feature: 17}, {feature: 205, add: true}}, 2},
+		{"capture", [4]featureUpdate{{feature: 17}, {feature: 205}, {feature: 390, add: true}}, 3},
+		{"castle", [4]featureUpdate{{feature: 17}, {feature: 205, add: true}, {feature: 390}, {feature: 767, add: true}}, 4},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			model := &Model{}
+			var parent, child [HiddenSize]float32
+			for lane := range parent {
+				parent[lane] = float32((lane%29)-14) * 0.125
+				child[lane] = math.Float32frombits(0x7fc00000 | uint32(lane+1))
+				for row := 0; row < test.count; row++ {
+					feature := test.updates[row].feature
+					model.hiddenWeights[feature*HiddenSize+lane] = float32(((lane+row*11)%31)-15) * 0.0625
+				}
+			}
+
+			// Dedicated lanes exercise cancellation/order, signed zero,
+			// subnormal boundaries, and halfway rounding across multiple rows.
+			parent[0] = 1e20
+			parent[1] = math.Float32frombits(0x80000000)
+			parent[2] = math.Float32frombits(0x00800000)
+			parent[3] = 1
+			for row := 0; row < test.count; row++ {
+				base := test.updates[row].feature * HiddenSize
+				switch row {
+				case 0:
+					model.hiddenWeights[base] = 1e20
+					model.hiddenWeights[base+1] = 0
+					model.hiddenWeights[base+2] = math.SmallestNonzeroFloat32
+					model.hiddenWeights[base+3] = math.Float32frombits(0x33800000)
+				case 1:
+					model.hiddenWeights[base] = 1
+					model.hiddenWeights[base+1] = math.Float32frombits(0x80000000)
+					model.hiddenWeights[base+2] = math.SmallestNonzeroFloat32
+					model.hiddenWeights[base+3] = math.Float32frombits(0x33800000)
+				default:
+					model.hiddenWeights[base] = 1
+					model.hiddenWeights[base+1] = 0
+					model.hiddenWeights[base+2] = -math.SmallestNonzeroFloat32
+					model.hiddenWeights[base+3] = math.Float32frombits(0x34000000)
+				}
+			}
+
+			parentBefore := parent
+			var weightsBefore [4][HiddenSize]float32
+			for row := 0; row < test.count; row++ {
+				base := test.updates[row].feature * HiddenSize
+				copy(weightsBefore[row][:], model.hiddenWeights[base:base+HiddenSize])
+			}
+			want := parent
+			applyTestUpdates(model, &want, test.updates[:test.count])
+			copyAndApplyFeatureUpdates(&child, &parent, model, &test.updates, test.count)
+
+			requireAccumulatorBits(t, child, want)
+			requireAccumulatorBits(t, parent, parentBefore)
+			for row := 0; row < test.count; row++ {
+				base := test.updates[row].feature * HiddenSize
+				for lane := 0; lane < HiddenSize; lane++ {
+					if got, want := math.Float32bits(model.hiddenWeights[base+lane]), math.Float32bits(weightsBefore[row][lane]); got != want {
+						t.Fatalf("row=%d lane=%d weight bits=%08x want=%08x", row, lane, got, want)
+					}
+				}
+			}
+		})
+	}
+}
