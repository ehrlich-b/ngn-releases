+func TestSearchContextMoveGrowsThenPreservesParentAndPop(t *testing.T) {
+	const from = 8
+	const to = 16
+	fromFeature := from
+	toFeature := to
+	model := loadedSearchModel(t, map[int]float32{
+		hiddenWeightsStart + fromFeature*HiddenSize: 1e20,
+		hiddenWeightsStart + toFeature*HiddenSize:   1,
+		outputWeightsStart:                          1,
+	})
+	root := boardWith(pieceAt(0, from), pieceAt(5, 4), pieceAt(11, 60))
+	post := boardWith(pieceAt(0, to), pieceAt(5, 4), pieceAt(11, 60))
+	context, err := model.NewSearchContext(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for context.Depth() < CompatibilityFrameCount-1 {
+		if err := context.PushNull(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	parentDepth := context.Depth()
+	parent := context.accumulators[parentDepth]
+	parentRaw := context.EvaluateRaw()
+	fromWeights := model.hiddenWeights[fromFeature*HiddenSize : (fromFeature+1)*HiddenSize]
+	toWeights := model.hiddenWeights[toFeature*HiddenSize : (toFeature+1)*HiddenSize]
+	fromBefore := append([]float32(nil), fromWeights...)
+	toBefore := append([]float32(nil), toWeights...)
+
+	delta := MoveDelta{MovingPlane: 0, From: from, To: to}
+	updates := []featureUpdate{{feature: fromFeature}, {feature: toFeature, add: true}}
+	want := parent
+	applyTestUpdates(model, &want, updates)
+	if err := context.PushMove(delta, post); err != nil {
+		t.Fatal(err)
+	}
+	if context.Depth() != CompatibilityFrameCount || context.FrameCapacity() != 2*CompatibilityFrameCount || context.Board() != post {
+		t.Fatalf("depth=%d capacity=%d board=%v", context.Depth(), context.FrameCapacity(), context.Board())
+	}
+	requireAccumulatorBits(t, context.accumulators[parentDepth], parent)
+	requireAccumulatorBits(t, context.accumulators[context.depth], want)
+	for lane := 0; lane < HiddenSize; lane++ {
+		if math.Float32bits(fromWeights[lane]) != math.Float32bits(fromBefore[lane]) ||
+			math.Float32bits(toWeights[lane]) != math.Float32bits(toBefore[lane]) {
+			t.Fatalf("model weight mutated at lane %d", lane)
+		}
+	}
+	if err := context.Pop(); err != nil {
+		t.Fatal(err)
+	}
+	if context.Depth() != parentDepth || context.Board() != root || math.Float32bits(context.EvaluateRaw()) != math.Float32bits(parentRaw) {
+		t.Fatal("pop after grown move did not restore parent state")
+	}
+	requireAccumulatorBits(t, context.accumulators[context.depth], parent)
+}
