@@ -3,6 +3,7 @@
 package countereval
 
 const featureUpdateRowsUseAVX2 = false
+const fusedFeatureUpdatesUseAVX2 = false
 
 func addFeatureRow(accumulator, weights *[HiddenSize]float32) {
 	addFeatureRowPortable(accumulator, weights)
@@ -11,3 +12,16 @@ func addFeatureRow(accumulator, weights *[HiddenSize]float32) {
 func subFeatureRow(accumulator, weights *[HiddenSize]float32) {
 	subFeatureRowPortable(accumulator, weights)
 }
+
+// Preserve the established portable copy followed by ordered complete-row
+// updates. Only amd64.v3 replaces this sequence with fused lane-independent
+// arithmetic.
+func copyAndApplyFeatureUpdates(
+	child, parent *[HiddenSize]float32,
+	model *Model,
+	updates *[4]featureUpdate,
+	updateCount int,
+) {
+	*child = *parent
+	applyFeatureUpdates(child, model, updates, updateCount)
+}
