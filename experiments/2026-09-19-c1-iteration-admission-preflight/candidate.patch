index 0000000..76d1f5e
--- /dev/null
+++ b/engine/time_iteration_admission_test.go
@@ -0,0 +1,128 @@
+package engine
+
+import (
+	"testing"
+	"time"
+)
+
+func c1BoundaryManager(elapsed time.Duration) (*TimeManager, *terminationObserverClock, *searchTerminationObserver) {
+	start := time.Unix(1000, 0)
+	clock := &terminationObserverClock{now: start.Add(elapsed)}
+	observer := &searchTerminationObserver{}
+	tm := configuredObserverTournament(clock, observer)
+	tm.startTime = start
+	return tm, clock, observer
+}
+
+func TestIterationAdmissionStrictProjectionBoundary(t *testing.T) {
+	for _, test := range []struct {
+		elapsed time.Duration
+		admit   bool
+	}{
+		{799 * time.Millisecond, true},
+		{800 * time.Millisecond, true},
+		{801 * time.Millisecond, false},
+	} {
+		t.Run(test.elapsed.String(), func(t *testing.T) {
+			tm, _, observer := c1BoundaryManager(test.elapsed)
+			tm.checkCounter = 17 // Admission is independent of the 1024-call poll cadence.
+			if got := tm.ShouldStartIteration(1); got != test.admit {
+				t.Fatalf("ShouldStartIteration at %v = %v, want %v", test.elapsed, got, test.admit)
+			}
+			if tm.checkCounter != 17 {
+				t.Fatalf("admission changed recursive poll counter to %d", tm.checkCounter)
+			}
+			if test.admit {
+				if observer.FirstReason != searchTerminationNone {
+					t.Fatalf("admitted boundary recorded %+v", observer)
+				}
+			} else if observer.FirstReason != searchTerminationSoftAdmission || observer.FirstDepth != 2 {
+				t.Fatalf("rejected boundary observation = %+v", observer)
+			}
+		})
+	}
+}
+
+func TestIterationAdmissionFinishesDepthOneAndPreservesZeroHistoryFallback(t *testing.T) {
+	t.Run("depth one ignores soft", func(t *testing.T) {
+		tm, _, observer := c1BoundaryManager(1500 * time.Millisecond)
+		if !tm.ShouldStartIteration(0) {
+			t.Fatalf("depth one rejected below hard bound: %+v", observer)
+		}
+	})
+
+	t.Run("no duration uses elapsed fallback", func(t *testing.T) {
+		tm, _, observer := c1BoundaryManager(time.Second)
+		tm.lastIterationTime = 0
+		if tm.ShouldStartIteration(1) {
+			t.Fatal("elapsed==soft with no previous duration was admitted")
+		}
+		if observer.FirstReason != searchTerminationSoftAdmission {
+			t.Fatalf("fallback observation = %+v", observer)
+		}
+	})
+}
+
+func TestAdmittedIterationIgnoresSoftButHonorsHardAndEmergency(t *testing.T) {
+	t.Run("soft then hard", func(t *testing.T) {
+		tm, clock, observer := c1BoundaryManager(801 * time.Millisecond)
+		if tm.ShouldStopSearch(7) {
+			t.Fatal("recursive check stopped an admitted iteration at the soft boundary")
+		}
+		if observer.FirstReason != searchTerminationNone {
+			t.Fatalf("recursive soft check recorded %+v", observer)
+		}
+
+		clock.now = tm.startTime.Add(3999 * time.Millisecond)
+		tm.checkCounter = 1023
+		if tm.ShouldStopSearch(7) {
+			t.Fatal("recursive check stopped below the hard deadline")
+		}
+		clock.now = tm.startTime.Add(4 * time.Second)
+		tm.checkCounter = 1023
+		if !tm.ShouldStopSearch(7) || observer.FirstReason != searchTerminationHardDeadline {
+			t.Fatalf("hard deadline observation = %+v", observer)
+		}
+	})
+
+	t.Run("emergency", func(t *testing.T) {
+		tm, clock, observer := c1BoundaryManager(0)
+		tm.baseTime = time.Second
+		tm.hardTime = 2 * time.Second
+		clock.now = tm.startTime.Add(901 * time.Millisecond)
+		tm.checkCounter = 1023
+		if !tm.ShouldStopSearch(7) || observer.FirstReason != searchTerminationEmergencyReserve {
+			t.Fatalf("emergency observation = %+v", observer)
+		}
+	})
+}
+
+func TestNewIterationMakesCompletedCostAvailableBeforeAdmission(t *testing.T) {
+	start := time.Unix(2000, 0)
+	clock := &terminationObserverClock{now: start}
+	var observer searchTerminationObserver
+	tm := newTimeManager(clock.Now)
+	tm.timeControl = Tournament
+	tm.startTime = start
+	tm.baseTime = 10 * time.Second
+	tm.softTime = time.Second
+	tm.hardTime = 4 * time.Second
+	tm.emergencyTime = 100 * time.Millisecond
+	tm.stableIters = 3
+	tm.setSearchTerminationObserver(&observer)
+	tm.iterationStartTime = start
+
+	clock.now = start.Add(200 * time.Millisecond)
+	tm.observeCompletedIteration(1, 1)
+	tm.NewIteration()
+	if tm.lastIterationTime != 200*time.Millisecond {
+		t.Fatalf("last iteration=%v, want 200ms", tm.lastIterationTime)
+	}
+	clock.now = start.Add(801 * time.Millisecond)
+	if tm.ShouldStartIteration(1) {
+		t.Fatal("new depth admitted past strict projected boundary")
+	}
+	if observer.IterationCount != 1 || observer.Iterations[0].Depth != 1 {
+		t.Fatalf("unstarted depth was reported completed: %+v", observer)
+	}
+}
