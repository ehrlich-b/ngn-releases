+// TransitionDiagnostics is a disposable V0 profiling observer. This patch is
+// applied only in the isolated diagnostic worktree and must never be merged.
+type TransitionDiagnostics struct {
+	MovePushes     uint64
+	NullPushes     uint64
+	UpdateCount2   uint64
+	UpdateCount3   uint64
+	UpdateCount4   uint64
+	WhiteRefreshes uint64
+	BlackRefreshes uint64
+}
