+// DiagnosticTransitionCounts returns the disposable V0 transition counters.
+func (context *SearchContext) DiagnosticTransitionCounts() TransitionDiagnostics {
+	if context == nil {
+		return TransitionDiagnostics{}
+	}
+	return context.transitionCounters
+}
+
+// ResetDiagnosticTransitionCounts clears the disposable V0 counters.
+func (context *SearchContext) ResetDiagnosticTransitionCounts() {
+	if context == nil {
+		return
+	}
+	context.transitionCounters = TransitionDiagnostics{}
+}
