 // SearchContext is one worker's dynamically growing V1.2 accumulator stack.
 // Frames own both evaluator input state and the two-perspective accumulator.
 type SearchContext struct {
-	model        *Model
-	accumulators []accumulator
-	positions    []Position
-	depth        int
+	model              *Model
+	accumulators       []accumulator
+	positions          []Position
+	depth              int
+	transitionCounters TransitionDiagnostics
 }
 
