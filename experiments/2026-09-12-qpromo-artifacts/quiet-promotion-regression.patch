+func TestQSearchQuietPromotionMates(t *testing.T) {
+	for _, fen := range []string{
+		"7k/5P2/6K1/8/8/8/8/8 w - - 0 1",
+		"8/8/8/8/8/6k1/5p2/7K b - - 0 1",
+	} {
+		pos, err := ParseFEN(fen)
+		if err != nil {
+			t.Fatal(err)
+		}
+		before := pos.Copy()
+		ClearStop()
+		ClearHistoryTable()
+		defaultSearchEngine, _ = NewSearchEngineWithHash(DEFAULT_CACHE_SIZE)
+		info := newQSearchInfo()
+		if got := quiescence(pos, -INFINITY, INFINITY, 0, info); got != MATE_VALUE-1 {
+			t.Fatalf("qsearch(%s)=%d, want exact mate score %d", fen, got, MATE_VALUE-1)
+		}
+		if !PositionEqual(before, pos) || info.FrameDepth != 0 || info.RepStackLen != 0 {
+			t.Fatalf("qsearch did not restore state: pos=%t frames=%d reps=%d", PositionEqual(before, pos), info.FrameDepth, info.RepStackLen)
+		}
+	}
+}
+
+func counterFeatureIndex(piece Piece, square Square) int {
+	return int(piece-WhitePawn)*64 + int(square)
+}
+
+func TestQSearchQuietPromotionCounterPushUnwind(t *testing.T) {
+	model := loadSparseCounterModel(t, map[int]float32{
+		countereval.InputSize * countereval.HiddenSize:                    0.5,
+		counterHiddenWeightIndex(counterFeatureIndex(WhitePawn, F7), 0):   1,
+		counterHiddenWeightIndex(counterFeatureIndex(WhiteKnight, F8), 0): 2,
+		counterHiddenWeightIndex(counterFeatureIndex(WhiteBishop, F8), 0): 3,
+		counterHiddenWeightIndex(counterFeatureIndex(WhiteRook, F8), 0):   4,
+		counterHiddenWeightIndex(counterFeatureIndex(WhiteQueen, F8), 0):  5,
+		counterOutputWeightIndex(0):                                       2,
+	})
+	searcher := NewSearchEngine()
+	if err := searcher.SelectCounter55Evaluator(model); err != nil {
+		t.Fatal(err)
+	}
+	pos, err := ParseFEN("7k/5P2/6K1/8/8/8/8/8 w - - 0 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := pos.Copy()
+
+	searcher.sessionMu.Lock()
+	defer searcher.sessionMu.Unlock()
+	generation := mustAcquireHCEModelUse()
+	defer releaseHCEModelUse()
+	tt := searcher.prepareTTGeneration(generation)
+	evaluator := searcher.mustPreparePrimaryEvaluator(pos, generation)
+	rootRaw := requireCounterRawMatchesFull(t, evaluator, pos)
+	if rootRaw != 3 {
+		t.Fatalf("root raw=%v, want 3", rootRaw)
+	}
+	info := newN3CDirectSearchInfo(searcher, evaluator, tt, 0)
+
+	promotionPushes := 0
+	sawChangedRaw := false
+	evaluator.transitionObserver = func(observedPos *Position, observedEvaluator *workerEvaluator) {
+		raw := requireCounterRawMatchesFull(t, observedEvaluator, observedPos)
+		if observedPos.Board.GetBitboardOf(WhitePawn)&SquareMask[F7] == 0 &&
+			observedPos.Board.PieceAt(F8) != NoPiece && observedPos.Board.PieceAt(F8).Type() != Pawn {
+			promotionPushes++
+			if raw != rootRaw {
+				sawChangedRaw = true
+			}
+		}
+	}
+
+	if got := quiescence(pos, -INFINITY, INFINITY, 0, info); got != MATE_VALUE-1 {
+		t.Fatalf("Counter qsearch=%d, want exact mate score %d", got, MATE_VALUE-1)
+	}
+	if promotionPushes == 0 || !sawChangedRaw {
+		t.Fatalf("Counter qsearch promotion pushes=%d changed-raw=%v", promotionPushes, sawChangedRaw)
+	}
+	if !PositionEqual(before, pos) || info.FrameDepth != 0 || info.RepStackLen != 0 || evaluator.nnueDepth() != 0 {
+		t.Fatalf("Counter qsearch did not restore state: pos=%t frames=%d reps=%d evaluator=%d",
+			PositionEqual(before, pos), info.FrameDepth, info.RepStackLen, evaluator.nnueDepth())
+	}
+	if restoredRaw := requireCounterRawMatchesFull(t, evaluator, pos); restoredRaw != rootRaw {
+		t.Fatalf("restored root raw=%v, want %v", restoredRaw, rootRaw)
+	}
+}
