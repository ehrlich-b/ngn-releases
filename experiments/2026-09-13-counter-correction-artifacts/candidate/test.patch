+func TestStaticEvalTTRefinementBoundariesUnchanged(t *testing.T) {
+	const staticEval = 100
+	tests := []struct {
+		name       string
+		hit        bool
+		singular   bool
+		ttEval     int
+		ttNodeType NodeType
+		want       int
+	}{
+		{"exact", true, false, 90, Exact, 90},
+		{"lower-better", true, false, 101, LowerBound, 101},
+		{"lower-equal", true, false, 100, LowerBound, staticEval},
+		{"lower-worse", true, false, 99, LowerBound, staticEval},
+		{"upper-better", true, false, 99, UpperBound, 99},
+		{"upper-equal", true, false, 100, UpperBound, staticEval},
+		{"upper-worse", true, false, 101, UpperBound, staticEval},
+		{"mate-boundary", true, false, MATE_IN_MAX, Exact, staticEval},
+		{"singular", true, true, 90, Exact, staticEval},
+		{"miss", false, false, 90, Exact, staticEval},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := refineStaticEvalFromTT(staticEval, test.hit, test.singular, test.ttEval, test.ttNodeType); got != test.want {
+				t.Fatalf("refined static=%d want=%d", got, test.want)
+			}
+		})
+	}
+}
