+void Engine::trace_eval() const {
+    StateListPtr trace_states(new std::deque<StateInfo>(1));
+    Position     p;
+    p.set(pos.fen(), options["UCI_Chess960"], &trace_states->back());
+
+    verify_networks();
+
+    sync_cout << "\n" << Eval::trace(p, *networks) << sync_endl;
+}
+
+#ifdef SF18_BIG_REFERENCE_ORACLE
+void Engine::trace_big_reference(const std::string& caseId,
+                                 const std::vector<std::string>& actions) const {
+    networks->big.verify(options["EvalFile"], onVerifyNetworks);
+    const auto rows = Eval::NNUE::SF18BigReferenceOracle::run(
+      pos.fen(), options["UCI_Chess960"], networks->big, tt, caseId, actions);
+    for (const auto& row : rows)
+        sync_cout << "SF18_BIG_REFERENCE_ORACLE_JSON " << row << sync_endl;
+}
+#endif
+
+const OptionsMap& Engine::get_options() const { return options; }
+OptionsMap&       Engine::get_options() { return options; }
